# --- LLM server connection ---
API_URL=<REPLACE_ME>                       # Ollama/OpenWebUI or other LLM endpoint
API_TOKEN=<REPLACE_ME>                     # Optional if local
MODEL_NAME=mistral:latest                  # Or llama3:latest / gpt-4o / etc.

# --- LLM behaviour ---
TEMPERATURE=0.1
SEED=42
TIMEOUT=90

# --- Trend computation (internal) ---
# No tuning needed unless you want to expose thresholds later.

# --- Logging & metadata ---
SERVICE_NAME=policy-success-evaluator
LOG_LEVEL=info
PORT=8000
