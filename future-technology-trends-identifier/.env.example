
# ================ API Configuration ================
API_TOKEN="<REPLACE_ME>"
API_URL="<REPLACE_ME>"   # OpenWebUI base URL (no trailing slash)
MODEL_NAME=mistral:latest
TEMPERATURE=0.0
SEED=42
TIMEOUT=240
# Optionally pass extra HTTP headers as JSON
# EXTRA_HEADERS_JSON={"X-Instance":"skillab-prod"}

# ================ Chunking / parsing ================
CHUNK_SIZE=6000
OVERLAP=400
MAX_PAGES=0
SKIP_PAGES=-1                        # comma-separated; negative -> from end

# ================ Performance ======================
PARALLEL_CHUNKS=1
PROGRESS_BAR=false

# ================ Heuristics =======================
PRIORITY_KEYWORDS=Horizon Europe,RIA,IA,work program,WP
EXCLUDE_SECTIONS=references,appendix,bibliography

# ================ Embeddings / ESCO ================
EMBED_MODEL=all-MiniLM-L6-v2
EMBED_BATCH_SIZE=128
ESCO_CACHE_DIR=storage/esco_cache
ESCO_OCCUPATIONS_CSV=esco_data/all_occupations.csv
ESCO_SKILLS_CSV=esco_data/all_skills.csv

# ================ Clustering =======================
DBSCAN_EPS=0.30
DBSCAN_MIN_SAMPLES=1
CLUSTER_MIN_SIZE=2

# ================ Files / Storage ==================
ESCO_DATA_FOLDER=esco_data
STORAGE_DIR=storage
