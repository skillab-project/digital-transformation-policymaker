
# ================ API Configuration ================
API_TOKEN="<REPLACE_ME>"
API_URL="http://160.40.52.27:3000"  # Base URL of your OpenWebUI instance
MODEL_NAME="mistral:latest"         # Default model to use

# ================ Chunking / parsing ================
CHUNK_SIZE=6000                 # Smaller chunks prevent timeouts (adjust for your model's context window)
OVERLAP=400                     # Maintains context between chunks
MAX_PAGES=0                     # 0=process all pages, set to limit for testing (e.g., 20)
TEMPERATURE=0.0
SEED=42

# ================ PERFORMANCE OPTIMIZATION ================
PARALLEL_CHUNKS=1               # Number of chunks to process simultaneously
SKIP_PAGES="-1"          		# Skip cover/TOC/last pages (comma-separated, negative = from end)
TIMEOUT=240           			# Seconds allowed per chunk analysis

# ================ LARGE DOCUMENT HEURISTICS ================
PRIORITY_KEYWORDS="Horizon Europe,RIA,IA,work program,WP"  	# Focus on these terms
EXCLUDE_SECTIONS="references,appendix,bibliography"  		# Skip these sections

# ======= Data files =======
DATASETS_FOLDER="datasets"
ESCO_OCCUPATIONS_CSV="datasets/all_occupations.csv"
ESCO_SKILLS_CSV="datasets/all_skills.csv"
