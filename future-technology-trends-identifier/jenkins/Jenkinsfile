pipeline {
    agent {
        node {
            label 'dev-server'
        }
    }
    environment {
        APP_NAME = "future-technology-trends-identifier"
        MAJOR_RELEASE = "0.1"
        DOCKER_TAG = "${MAJOR_RELEASE}.${env.BUILD_NUMBER}"
        DOCKER_REG = "harbor.skillab-project.eu"
        DOCKER_REPO = "/skillab-all/"
        DOCKER_REG_CREDS = "harbor-creds"
		ENV_FILE_CREDENTIALS = "llm-api-creds"
    }

    stages {
		// *********************************
        // *** CREATE .env from Jenkins ****
        // *********************************
        stage("Prepare Env File") {
            steps {
                withCredentials([usernamePassword(credentialsId: "${ENV_FILE_CREDENTIALS}", usernameVariable: 'API_USER', passwordVariable: 'API_PASS')]) {
                    echo "***** Creating .env file *****"
					sh """
						echo "API_TOKEN=${API_PASS}" >> .env
						echo "API_URL=http://160.40.52.27:3000" >> .env
						echo "MODEL_NAME=mistral:latest" >> .env
						echo "TEMPERATURE=0.0" >> .env
						echo "SEED=42" >> .env
						echo "TIMEOUT=240" >> .env
						# ================ Chunking / parsing ================
						echo "CHUNK_SIZE=6000" >> .env
						echo "OVERLAP=400" >> .env
						echo "MAX_PAGES=0" >> .env
						echo "SKIP_PAGES=-1" >> .env
						# ================ Performance ======================
						echo "PARALLEL_CHUNKS=1" >> .env
						echo "PROGRESS_BAR=false" >> .env
						# ================ Heuristics =======================
						echo "PRIORITY_KEYWORDS=Horizon Europe,RIA,IA,work program,WP" >> .env
						echo "EXCLUDE_SECTIONS=references,appendix,bibliography" >> .env
						# ================ Embeddings / ESCO ================
						echo "EMBED_MODEL=all-MiniLM-L6-v2" >> .env
						echo "EMBED_BATCH_SIZE=128" >> .env
						echo "ESCO_CACHE_DIR=storage/esco_cache" >> .env
						echo "ESCO_OCCUPATIONS_CSV=esco_data/all_occupations.csv" >> .env
						echo "ESCO_SKILLS_CSV=esco_data/all_skills.csv" >> .env
						# ================ Clustering =======================
						echo "DBSCAN_EPS=0.30" >> .env
						echo "DBSCAN_MIN_SAMPLES=1" >> .env
						echo "CLUSTER_MIN_SIZE=2" >> .env
						# ================ Files / Storage ==================
						echo "ESCO_DATA_FOLDER=esco_data" >> .env
						echo "STORAGE_DIR=storage" >> .env
					"""
                }
            }
        }
	
        // *************************
        // *** IMAGE BUILD STAGE ***
        // *************************
        stage("Build_Docker_Images"){
            steps {
                echo "***** Building Docker Image *****"
                sh "docker build -t ${APP_NAME}:test ."
            }
        }
		
		// **************************
        // *** RUN THE UNIT TESTS ***
        // **************************
        stage("Run_Unit_Tests"){
            steps {
                echo "***** Running Unit Tests *****"
				sh "docker run --rm --env-file .env -e PYTHONPATH=/app ${APP_NAME}:test pytest"
            }
        }

        // ****************************
        // *** Push Images In Harbor ***
        // ****************************
        stage("Push_Image"){
            when {
                environment name: "GIT_BRANCH", value: "origin/main"
            }
            steps {
                withCredentials([[$class: 'UsernamePasswordMultiBinding', credentialsId: "${DOCKER_REG_CREDS}", usernameVariable: 'USERNAME', passwordVariable: 'PASSWORD']]){
                    echo "***** Push Docker Image *****"
                    sh 'docker tag ${APP_NAME}:test ${DOCKER_REG}${DOCKER_REPO}${APP_NAME}:${DOCKER_TAG}'
                    sh 'docker login ${DOCKER_REG} -u ${USERNAME} -p ${PASSWORD}'
                    sh 'docker push ${DOCKER_REG}${DOCKER_REPO}${APP_NAME}:${DOCKER_TAG}'
					
					// Also tag and push as latest
                    sh 'docker tag ${APP_NAME}:test ${DOCKER_REG}${DOCKER_REPO}${APP_NAME}:latest'
                    sh 'docker push ${DOCKER_REG}${DOCKER_REPO}${APP_NAME}:latest'
                }
            }
        }
        
        // **************
        // *** Deploy ***
        // **************
        stage("Deployment"){
            when {
                environment name: "GIT_BRANCH", value: "origin/main"
            }

            steps {
                withCredentials([[$class: 'UsernamePasswordMultiBinding', credentialsId: "${DOCKER_REG_CREDS}", usernameVariable: 'USERNAME', passwordVariable: 'PASSWORD']]){
                    echo "***** Deploy Application *****"
                    sh 'docker login ${DOCKER_REG} -u ${USERNAME} -p ${PASSWORD}'
                    sh 'docker pull ${DOCKER_REG}${DOCKER_REPO}${APP_NAME}:${DOCKER_TAG}'
					sh 'docker stop ${APP_NAME} || true'
					sh 'docker rm ${APP_NAME} || true'
                    sh 'docker run -d --env-file .env --name ${APP_NAME} -p 8875:8875 ${DOCKER_REG}${DOCKER_REPO}${APP_NAME}:${DOCKER_TAG}'
                    sh 'docker ps'
                }
            }
        }
    }
    post{
        always {
            // Remove specific images
            sh 'docker rmi ${APP_NAME}:test || true'
        }
        failure {
            echo "Build failed. Cleaned up docker environment."
            sh 'docker rmi ${APP_NAME}:${DOCKER_TAG} || true'
            sh 'docker rmi ${APP_NAME}:latest || true'
        }
    }
}
